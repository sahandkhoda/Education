                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>XMP08 Spec: A structure containing the characteristics of a colorant (swatch) used in a document.</pdfaType:description>
                           <pdfaType:namespaceURI>http://ns.adobe.com/xap/1.0/g/</pdfaType:namespaceURI>
                           <pdfaType:prefix>xmpG</pdfaType:prefix>
